# Security headers for every response. CSP is Report-Only until violations are
# reviewed in production; flip the header name to Content-Security-Policy after.
# Script hashes cover the inline theme bootstrap and the GA4 gtag config in index.html.
# static.cloudflareinsights.com is allowed only while the Cloudflare Web
# Analytics beacon is kept (see CHANGES.md, T6); remove it if the beacon is disabled.
# googletagmanager.com / google-analytics.com / analytics.google.com are allowed for the
# GTM container (GTM-NZTCPNLD) loaded in index.html and its GA4 collection. If the container
# adds tags that call other origins, allow those here too before enforcing CSP.
# localhost/127.0.0.1 connect-src entries exist for local preview testing and are
# harmless in Report-Only; drop them when enforcing if desired.
/*
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' 'sha256-VcLsWQvB/nH9DoWMuUn10DnaTDQV35Vr29o0xZkYxEk=' 'sha256-1kHMIQjagQ8sOu7WlfW0ho6fer6lYHJ644FFk/KjKDQ=' https://static.cloudflareinsights.com https://www.googletagmanager.com https://www.google-analytics.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://fra.cloud.appwrite.io https://www.google-analytics.com; font-src 'self'; connect-src 'self' https://server.drawspace.cloud wss://server.drawspace.cloud https://fra.cloud.appwrite.io https://www.googletagmanager.com https://www.google-analytics.com https://analytics.google.com http://localhost:3001 ws://localhost:3001 http://127.0.0.1:3001 ws://127.0.0.1:3001; media-src 'self' blob: data:; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY

# Optimized static media is versioned by filename, so it can be cached immutably.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Self-hosted variable fonts (latin). Rename files if the font files change.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Browser/OS icons stay PNG and may be replaced in place; cache for a day.
/favicon-32.png
  Cache-Control: public, max-age=86400
/favicon-192.png
  Cache-Control: public, max-age=86400
/apple-touch-icon.png
  Cache-Control: public, max-age=86400