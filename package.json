{
  "name": "drawspace",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && node scripts/build.mjs && node -e \"fs.copyFileSync('dist/index.html', 'dist/200.html')\"",
    "build:analyze": "node scripts/build.mjs --analyze",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "optimize:images": "node server/scripts/optimize-static-media.mjs",
    "server": "tsx server/src/index.ts",
    "test": "tsx --test server/src/**/*.test.ts",
    "test:http-e2e": "tsx --test server/src/httpE2e.test.ts",
    "test:redis-integration": "tsx --test server/src/socket/redisAdapter.integration.test.ts server/src/state/redisRoomState.integration.test.ts",
    "test:appwrite-integration": "node --env-file-if-exists=.env.local --import tsx --test server/src/repositories/appwrite.integration.test.ts",
    "appwrite:permissions:dry-run": "node --env-file-if-exists=.env.local server/scripts/harden-appwrite-permissions.mjs --dry-run",
    "appwrite:admin-features:dry-run": "node --env-file-if-exists=.env.local server/scripts/migrate-admin-features.mjs --dry-run",
    "server:typecheck": "tsc --project server/tsconfig.json --noEmit",
    "server:test": "tsx --test server/src/**/*.test.ts",
    "server:dev": "tsx watch server/src/index.ts",
    "server:build": "tsc --project server/tsconfig.build.json",
    "start": "node server/dist/server/src/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@socket.io/redis-adapter": "^8.3.0",
    "@tanstack/react-query": "^5.108.0",
    "appwrite": "^29.2.0",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "ioredis": "^6.0.0",
    "lucide-react": "^0.469.0",
    "node-appwrite": "^31.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "redis": "^6.3.1",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "rollup-plugin-visualizer": "^7.1.3",
    "typescript": "^5.6.3",
    "vite": "^6.0.0"
  }
}
