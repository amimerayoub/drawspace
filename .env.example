# Public browser configuration only. Set in Cloudflare Pages or local .env.local.
VITE_APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=your_appwrite_project_id
VITE_GAME_SERVER_URL=http://localhost:3001

# Backend-only values. Configure in Railway or an ignored local .env.local.
APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=your_appwrite_project_id
APPWRITE_API_KEY=replace_with_a_server_only_api_key
DATABASE_ID=drawspace_db
PORT=3001
NODE_ENV=development
FRONTEND_ORIGINS=http://localhost:5173,https://drawspace.cloud
ROOM_STATE_DRIVER=memory
# Production multi-instance deployments must set ROOM_STATE_DRIVER=redis and configure the same Redis URL on every instance.
# REDIS_URL=redis://localhost:6379
